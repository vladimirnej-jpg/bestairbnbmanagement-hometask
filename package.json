{
  "name": "bestairbnb-take-home",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "inngest:dev": "pnpm dlx inngest-cli@latest dev -u http://127.0.0.1:3000/api/inngest",
    "smoke:live": "tsx scripts/smoke-live-integrations.ts",
    "reset:demo": "TMPDIR=/tmp tsx scripts/reset-demo.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@next/env": "16.3.3",
    "@prisma/client": "6.6.0",
    "@react-email/components": "0.0.36",
    "@react-email/render": "1.0.6",
    "@tanstack/react-query": "5.74.4",
    "bcryptjs": "3.0.3",
    "googleapis": "176.0.0",
    "inngest": "4.18.1",
    "jose": "6.2.10",
    "next": "16.3.3",
    "openai": "7.5.0",
    "pino": "9.14.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.56.1",
    "server-only": "0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.24.0",
    "@inngest/test": "1.0.0",
    "@playwright/test": "1.62.1",
    "@types/node": "22.15.3",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "autoprefixer": "10.4.21",
    "eslint": "9.24.0",
    "globals": "16.0.0",
    "postcss": "8.5.3",
    "prettier": "3.5.3",
    "prisma": "6.6.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.29.0",
    "vitest": "3.1.1"
  }
}
