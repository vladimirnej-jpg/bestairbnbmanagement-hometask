NODE_ENV=development
PROVIDER_MODE=fake
PORT=3000
DATABASE_URL=postgresql://bestairbnb:bestairbnb@localhost:5432/bestairbnb?schema=public
DIRECT_URL=postgresql://bestairbnb:bestairbnb@localhost:5432/bestairbnb?schema=public
JWT_SECRET=local-development-secret-change-before-sharing-123456
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
INNGEST_DEV=1
INNGEST_EVENT_KEY=replace-with-inngest-event-key
INNGEST_SIGNING_KEY=replace-with-inngest-signing-key
GOOGLE_SHEETS_SPREADSHEET_ID=replace-with-non-production-sheet-id
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON_BASE64=replace-with-base64-service-account-json
GOOGLE_GMAIL_CLIENT_ID=replace-with-oauth-client-id
GOOGLE_GMAIL_CLIENT_SECRET=replace-with-oauth-client-secret
GOOGLE_GMAIL_REFRESH_TOKEN=replace-with-non-production-refresh-token
GOOGLE_GMAIL_USER_ID=me
GOOGLE_GMAIL_QUERY=label:inbox newer_than:30d
GOOGLE_GMAIL_MAX_RESULTS=50
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_MAX_RESULTS=25
OPENROUTER_API_KEY=replace-with-openrouter-api-key
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
OPENROUTER_FALLBACK_MODELS=
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OPS_USER_EMAIL=ops@example.com
OPS_USER_PASSWORD=ops-demo-password
MONITOR_USER_EMAIL=monitor@example.com
MONITOR_USER_PASSWORD=monitor-demo-password
